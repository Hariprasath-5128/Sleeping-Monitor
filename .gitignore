# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Runtime state written by the pipeline ──
# img_process.py publishes these every frame; app.py serves them to the ESP32.
status.json
status.json.tmp
status.txt
live_frame.jpg
live_frame.jpg.tmp
position_log.csv

# ── Federated learning store ──
# Locally trained and aggregated models; regenerated on every run.
fl_store/

# ── Training data and generated media ──
# The IR dataset and the animations built from it are large and reproducible
# from tools/. Keep them out of the repo.
data/
labeled_zone_dataset/
dataset/
dataset_split/
runs/
*.gif

# ── Scratch ──
test.jpg
*.bak
*.tmp
